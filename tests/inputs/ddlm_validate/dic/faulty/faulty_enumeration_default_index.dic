data_TEST

    _dictionary.title            Test
    _dictionary.class            Instance
    _dictionary.version          0.0.1
    _dictionary.date             2026-04-16
    _dictionary.uri              https://example.org/test_enumeration_defaults.dic
    _dictionary.doi              10.5555/12345678
    _dictionary.licensing_spdx   CC-BY-4.0
    _dictionary.ddl_conformance  4.2.0
    _dictionary.namespace        TestDic
    _description.text
;
    This dictionary contains definitions with the _enumeration_default.index
    attribute. Some of these definition are purposely faulty for testing
    purposes.
;
    loop_
    _dictionary_audit.version
    _dictionary_audit.date
    _dictionary_audit.revision
    0.0.1 2026-04-16 'Creating the dictionary'

