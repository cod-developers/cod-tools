save_test_looped.multi_def_index_ids_non_unique

    _definition.id               '_test_looped.multi_def_index_ids_non_unique'
    _definition.scope            Item
    _definition.class            Attribute
    _definition.update           2026-04-16
    _description.text
;
     Data item with the _enumeration.def_index_ids attribute consisting
     of multiple values some of which are incorrectly collectively non-unique.
;
    _name.category_id            test_looped
    _name.object_id              multi_def_index_ids_non_unique
    _type.purpose                Encode
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text

    _enumeration.def_index_ids
        [ '_test_looped.code_property_1' '_test_looped.integer_property_1' ]

     loop_
         _enumeration_defaults.index
         _enumeration_defaults.value
    [ A 1 ] ant [ B 2 ] bee [ C 3 ] cat [ c 3 ] Cat

save_

save_test_looped.multi_def_index_ids_type_violation

    _definition.id               '_test_looped.multi_def_index_ids_type_violation'
    _definition.scope            Item
    _definition.class            Attribute
    _definition.update           2026-04-16
    _description.text
;
     Data item with the _enumeration.def_index_ids attribute consisting
     of multiple values some of which violate the declared content type.
;
    _name.category_id            test_looped
    _name.object_id              multi_def_index_ids_type_violation
    _type.purpose                Encode
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text

    _enumeration.def_index_ids
        [ '_test_looped.code_property_1' '_test_looped.integer_property_1' ]

     loop_
         _enumeration_defaults.index
         _enumeration_defaults.value
    [ A 1 ] ant [ 'B ' 2 ] bee [ C A ] cat [ c 3 ] Cat

save_

