save_test_looped.single_code_def_index_ids

    _definition.id               '_test_looped.single_code_def_index_ids'
    _definition.scope            Item
    _definition.class            Attribute
    _definition.update           2026-04-16
    _description.text
;
     Data item with the _enumeration.def_index_ids attribute consisting
     of a single value of the code type
;
    _name.category_id            test_looped
    _name.object_id              single_code_def_index_ids
    _type.purpose                Encode
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text

    _enumeration.def_index_ids    ['_test_looped.code_property_1']

     loop_
         _enumeration_defaults.index
         _enumeration_defaults.value
    [ A ] ant [ B ] bee [ C ] cat [ c ] Cat

save_

save_test_looped.single_integer_def_index_ids

    _definition.id               '_test_looped.single_integer_def_index_ids'
    _definition.scope            Item
    _definition.class            Attribute
    _definition.update           2026-04-16
    _description.text
;
     Data item with the _enumeration.def_index_ids attribute consisting
     of a single value of the integer type.
;
    _name.category_id            test_looped
    _name.object_id              single_integer_def_index_ids
    _type.purpose                Encode
    _type.source                 Recorded
    _type.container              Single
    _type.contents               Text

    _enumeration.def_index_ids    ['_test_looped.integer_property_1']

     loop_
