save_valid_enum_default_index_ids.valid_ref

_definition.id               '_valid_enum_default_index_ids.valid_ref'
_definition.update           2021-08-21
_description.text
;
 Data item definition that contains a properly used
 '_enumeration.def_index_ids' attribute
;
_name.category_id            valid_enum_default_index_ids
_name.object_id              valid_ref
_type.purpose                Describe
_type.source                 Assigned
_type.container              Single
_type.contents               Text
_enumeration.def_index_ids   [ '_valid_enum_default_index_ids.index_item' ]
loop_
    _enumeration_defaults.index
    _enumeration_defaults.value
        [ a ] state_1
        [ b ] state_2
        [ c ] state_1

save_

save_invalid_enum_default_index_ids.undefined_ref

_definition.id               '_invalid_enum_default_index_ids.undefined_ref'
_definition.update           2021-08-21
_description.text
;
 Data item definition that contains the '_enumeration.def_index_ids' attribute
 that references a non-existent data items.
;
_name.category_id            invalid_enum_default_index_ids
_name.object_id              undefined_ref
_type.purpose                Describe
_type.source                 Assigned
_type.container              Single
_type.contents               Text
_enumeration.def_index_ids   [
    '_undefined.item_1'
    '_valid_enum_default_index_ids.index_item'
    '_undefined.item_2'
                             ]
loop_
    _enumeration_defaults.index
    _enumeration_defaults.value
        [ a b c ] state_1
        [ b c a ] state_2
        [ c a b ] state_1

save_

