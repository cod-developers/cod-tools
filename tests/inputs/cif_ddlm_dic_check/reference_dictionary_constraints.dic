#\#CIF_2.0
##############################################################################
#                                                                            #
#                       Test DDLm reference dictionary                       #
#                                                                            #
##############################################################################
data_DDL_DIC

    _dictionary.title             DDL_DIC
    _dictionary.class             Reference
    _dictionary.version           0.0.1
    _dictionary.date              2026-06-09
    _dictionary.uri
        http://www.fake.org/test_ddlm_reference.dic
    _dictionary.ddl_conformance   0.0.1
    _dictionary.namespace         DdlDic
    _description.text
;
    This dictionary mimics the DDLm reference dictionary for testing purposes.
    Specifically, it contains two special types of attribute values:
    - Values that are prohibited in the Reference dictionary
      (PROHIBITED_FEATURES category).
    - Values that are permitted only in the Reference dictionary
      (EXCLUSIVE_FEATURES category).
;

    loop_
      _dictionary_audit.version
      _dictionary_audit.date
      _dictionary_audit.revision
         0.0.1                    2026-06-09
;
       Initial release of the dictionary.
;

save_ATTRIBUTES

    _definition.id                ATTRIBUTES
    _definition.scope             Category
    _definition.class             Head
    _definition.update            2023-07-16
    _description.text
;
    This category is parent of all other categories in the DDLm dictionary.
;
    _name.category_id             DDL_DIC
    _name.object_id               ATTRIBUTES

save_

save_PROHIBITED_FEATURES

    _definition.id                PROHIBITED_FEATURES
    _definition.scope             Category
    _definition.class             Set
    _definition.update            2023-07-16
    _description.text
;
    This category contains definitions with attribute values that are prohibited
    in the DDLm reference dictionary.
;
    _name.category_id             ATTRIBUTES
    _name.object_id               PROHIBITED_FEATURES

save_

save_prohibited_features.datum_class

    _definition.id                '_prohibited_features.datum_class'
    _definition.class             Datum
    _definition.update            2023-07-16
    _description.text
;
    Attribute definition with an explicit Datum class.
;
    _name.category_id             prohibited_features
    _name.object_id               datum_class
    _type.purpose                 Describe
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text

save_

save_prohibited_features.default_class

    _definition.id                '_prohibited_features.default_class'
    _definition.update            2023-07-16
    _description.text
;
    Attribute definition without an explicit class (defaults to 'Datum').
;
    _name.category_id             prohibited_features
    _name.object_id               default_class
    _type.purpose                 Describe
    _type.source                  Assigned
    _type.container               Single
    _type.contents                Text

save_

save_EXCLUSIVE_FEATURES

    _definition.id               EXCLUSIVE_FEATURES
    _definition.scope            Category
    _definition.class            Set
    _definition.update           2023-11-09
    _description.text
;
    A category that contains data item definitions with attribute values that
    are permitted only in the DDLm reference dictionary.
;
    _name.category_id            EXCLUSIVE_FEATURES
    _name.object_id              ATTRIBUTES

save_

