[ Fe_1 ] { fillcolor: #E06633; fixedsize: true; shape: circle; style: filled; }
[ Pt_1 ] { fillcolor: #D0D0E0; fixedsize: true; shape: circle; style: filled; }

[ Fe_1 ] -- 0,-1,0 --> [ Fe_1 ]
[ Fe_1 ] -- -1,0,0 --> [ Fe_1 ]
[ Fe_1 ] --> { arrowstyle: none; } [ Pt_1 ]
[ Fe_1 ] -- 0,-1,0 --> [ Pt_1 ]
[ Fe_1 ] -- -1,0,0 --> [ Pt_1 ]
[ Fe_1 ] -- -1,-1,0 --> [ Pt_1 ]
[ Fe_1 ] -- 0,0,1 --> [ Pt_1 ]
[ Fe_1 ] -- 0,-1,1 --> [ Pt_1 ]
[ Fe_1 ] -- -1,0,1 --> [ Pt_1 ]
[ Fe_1 ] -- -1,-1,1 --> [ Pt_1 ]
[ Pt_1 ] -- 0,1,0 --> [ Pt_1 ]
[ Pt_1 ] -- 1,0,0 --> [ Pt_1 ]
