##! /bin/sh
#!perl -w # --*- Perl -*--
eval 'exec perl -x $0 ${1+"$@"}'
    if 0;
#------------------------------------------------------------------------------
#$Author: yaroslav $
#$Revision: 9355 $
#$URL: svn+ssh://www.crystallography.net/home/coder/svn-repositories/cod-tools/tags/v3.7.0/scripts/cif2qg $
#$Date: 2022-07-31 23:15:34 +0300 (Sun, 31 Jul 2022) $
#------------------------------------------------------------------------------
#*
#* Parse CIF file and print out the the quotient graph.
#*
#* USAGE:
#*    $0 [options] input.cif [input2.cif ...]
#**

use COD::CIF::Parser qw( parse_cif );
use COD::CIF::Tags::CanonicalNames qw( canonicalize_all_names );
use COD::UserMessage qw( error );
use COD::SOptions qw( getOptions );
use Graph::Easy;
use COD::SUsage qw( usage options );
use COD::ToolsVersion qw( get_version_string );
use Math::Matrix;
use Inline Java => <<'JAVA';
import org.jgrapht.*;
import org.jgrapht.graph.*;
import org.jgrapht.alg.cycle.*;
import java.util.*;
import java.util.stream.Collectors;
import org.jgrapht.alg.interfaces.*;
import org.jgrapht.alg.interfaces.CycleBasisAlgorithm.*;


public class GraphHandler {
    public class LabeledEdge extends DefaultEdge {
        private int[] label;

        public LabeledEdge(String labelStr) {
            this.label = Arrays.stream(labelStr.split(","))
                        .mapToInt(Integer::parseInt)
                        .toArray();
        }

        public int[] getLabel() {
            return label;
        }

        @Override
        public String toString() {
            return "(" + getSource() + " : " + getTarget() + " [" + Arrays.toString(label) + "])";
        }
    }
    private SimpleDirectedWeightedGraph<String, LabeledEdge> graph;

    public GraphHandler() {
        graph = new SimpleDirectedWeightedGraph<>(LabeledEdge.class);
    }

    public void addVertex(String vertex) {
        graph.addVertex(vertex);
    }

    public void addEdge(String v1, String v2, String label) {
        graph.addEdge(v1, v2, new LabeledEdge(label));
    }

    public String findCycles() {
        QueueBFSFundamentalCycleBasis<String, LabeledEdge> fcb = new QueueBFSFundamentalCycleBasis<>(graph);
        CycleBasis<String, LabeledEdge> cb = fcb.getCycleBasis();
        List<List<LabeledEdge>> cycles = new ArrayList<>(cb.getCycles());

        if (cycles.isEmpty()) {
            return "No cycles found.";
        } else {
            StringBuilder sb = new StringBuilder();
            for (List<LabeledEdge> cycle : cycles) {
                sb.append(cycleToString(cycle));
                sb.append("\n");
            }
            return sb.toString();
        }
    }

    public String cycleToString(List<LabeledEdge> cycle) {
        StringBuilder sb = new StringBuilder();
        for (LabeledEdge edge : cycle) {
            String source = graph.getEdgeSource(edge);
            String target = graph.getEdgeTarget(edge);
            int[] label = edge.getLabel();
            sb.append("(").append(source).append(" : ").append(target).append(" [").append(Arrays.toString(label)).append("]), ");
        }
        if (sb.length() > 2) {
            sb.setLength(sb.length() - 2);
        }
        return sb.toString();
    }

    public int[][] getCycleMatrix() {
        QueueBFSFundamentalCycleBasis<String, LabeledEdge> fcb = new QueueBFSFundamentalCycleBasis<>(graph);
        CycleBasis<String, LabeledEdge> cb = fcb.getCycleBasis();
        List<List<LabeledEdge>> cycles = new ArrayList<>(cb.getCycles());

        if (cycles.isEmpty()) {
            return new int[0][0];
        } else {
            int labelSize = 3;
            int[][] matrix = new int[cycles.size()][labelSize];

            for (int i = 0; i < cycles.size(); i++) {
                int[] sumLabel = new int[labelSize];
                List<LabeledEdge> cycle = cycles.get(i);
                for (LabeledEdge edge : cycle) {
                    int[] label = edge.getLabel();
                    for (int j = 0; j < label.length; j++) {
                        sumLabel[j] += label[j];
                    }
                }
                matrix[i] = sumLabel;
            }

            return matrix;
        }
    }

    public String getCycleMatrixAsString() {
        QueueBFSFundamentalCycleBasis<String, LabeledEdge> fcb = new QueueBFSFundamentalCycleBasis<>(graph);
        CycleBasis<String, LabeledEdge> cb = fcb.getCycleBasis();
        List<List<LabeledEdge>> cycles = new ArrayList<>(cb.getCycles());

        if (cycles.isEmpty()) {
            return "No cycles found.";
        } else {
            StringBuilder sb = new StringBuilder();
            for (List<LabeledEdge> cycle : cycles) {
                int[] sumLabel = new int[3];
                for (LabeledEdge edge : cycle) {
                    int[] label = edge.getLabel();
                    for (int i = 0; i < label.length; i++) {
                        sumLabel[i] += label[i];
                    }
                }
                sb.append(Arrays.toString(sumLabel));
                sb.append("\n");
            }
            return sb.toString().trim();
        }
    }

    public String getVertices() {
        return graph.vertexSet().toString();
    }

    public String getEdges() {
        return graph.edgeSet().toString();
    }
}
JAVA

my $debug;
my $use_parser = 'c';
my %options;
my $as_ascii = 0;
my $as_txt = 0;
my $as_svg = 0;
my $as_boxart = 0;
my $as_html = 0;
@ARGV = getOptions(

#* OPTIONS:
#*
#*   --use-c-parser
#*                     Use Perl & C parser for CIF parsing (default).
#*   --use-perl-parser
#*                     Use Perl parser for CIF parsing.
#*   --as-ascii
#*                     Output as ascii
#*   --as-txt
#*                     Output as txt
#*   --as-svg
#*                     Output as svg
#*   --as-boxart
#*                     Output as boxart
#*   --as-html
#*                     Output as html
#*   --help, --usage
#*                     Output a short usage message (this message) and exit.
#*   --version
#*                     Output version information and exit.
#**

    "--debug"    => sub { $debug = 1 },
    "--use-perl-parser" => sub{ $use_parser = 'perl' },
    "--use-c-parser"    => sub{ $use_parser = 'c' },
    '--as-ascii' => sub { $as_ascii = 1 },
    '--as-txt' => sub { $as_txt = 1 },
    '--as-svg' => sub { $as_svg = 1 },
    '--as-boxart' => sub { $as_boxart = 1 },
    '--as-html' => sub { $as_html = 1 },
    '--help,--usage' => sub { usage; exit },
    '--version'      => sub { print get_version_string(), "\n"; exit },
);

@ARGV = ( "-" ) unless @ARGV;

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

my $first = 1;

for my $filename (@ARGV) {

    my $options = { 'parser' => $use_parser, 'no_print' => 1 };
    my ( $data, $err_count, $messages ) = parse_cif( $filename, $options );

    if( $err_count > 0 ) {
        print STDERR $_ foreach ( @$messages );
        error( {
            'program'  => $0,
            'filename' => $filename,
            'message'  =>
                "$err_count error(s) encountered while parsing the file"
        } );
        next;
    }
    print STDERR $_ foreach ( @$messages );

    canonicalize_all_names( $data, $options );

    my $graph_handler = new GraphHandler;

    foreach my $data (@$data) {
        my @atoms = @{ $data->{values}{'_topol_atom.atom_label'} };
        my @labels = @{ $data->{values}{'_topol_atom.edge_label'} };
        foreach my $atom (@atoms) {
            $graph_handler->addVertex($atom);
        }

        my @destinations = @{ $data->{values}{'_topol_atom.atom_edge_destination_label'} };
        foreach my $atom (@destinations) {
            $graph_handler->addVertex($atom);
        }
        for my $i (0..$#atoms) {
            $graph_handler->addEdge($atoms[$i], $destinations[$i], $labels[$i]);
        }
    }

    if($debug) {
        my $vertices = $graph_handler->getVertices();
        my $edges = $graph_handler->getEdges();

        print "Vertices:\n$vertices";
        print "Edges:\n$edges";
        my $cycles = $graph_handler->findCycles();
        print "Cycles:\n$cycles";
    }
    my $matrix_string = $graph_handler->getCycleMatrixAsString();

    if ($matrix_string eq "No cycles found.") {
        print "No cycles found.\n";
    } else {
        my @matrix = map { 
        my @row = split /,\s*/;
            $_ =~ s/[\[\]]//g for @row;
            [map { int($_) } @row]
                } split /\n/, $matrix_string;

        my $A = Math::Matrix -> new(@matrix);

        my $d = $A->det();
        print "Determinate $d\n";
    }
}

sub extract_atom_symbol {
    my ($atom_label) = @_;
    if ($atom_label =~ /^([A-Za-z]+)/) {
        return $1;
    }
    return $atom_label;
}
