#! /bin/sh
#!perl -w # --*- Perl -*--
eval 'exec perl -x $0 ${1+"$@"}'
    if 0;
#------------------------------------------------------------------------------
#$Author: yaroslav $
#$Revision: 9355 $
#$URL: svn+ssh://www.crystallography.net/home/coder/svn-repositories/cod-tools/tags/v3.7.0/scripts/cif2qg $
#$Date: 2022-07-31 23:15:34 +0300 (Sun, 31 Jul 2022) $
#------------------------------------------------------------------------------
#*
#* Parse CIF file and print out the the quotient graph.
#*
#* USAGE:
#*    $0 [options] input.cif [input2.cif ...]
#**

use strict;
use COD::CIF::Parser qw( parse_cif );
use COD::CIF::Tags::CanonicalNames qw( canonicalize_all_names );
use COD::UserMessage qw( error );
use COD::SOptions qw( getOptions );
use Graph::Easy;

my $use_parser = 'c';
my %options;
my $strict = 0;
my $canonical = 0;
@ARGV = getOptions(

#* OPTIONS:
#*
#*   --strict
#*                     Strictly adhere to JSON syntax, i.e., make a top level
#*                     list container for CIF data blocks and put comma (",")
#*                     separators between consecutive CIF data blocks.
#*   --no-strict, --relaxed, --stream, --concatenate
#*                     Print stream of JSON objects, where an object stands for
#*                     a CIF data block. Such output does not include comma (",")
#*                     separators between top level objects, thus streaming
#*                     parsers have to be used (default).
#*
#*   --use-c-parser
#*                     Use Perl & C parser for CIF parsing (default).
#*   --use-perl-parser
#*                     Use Perl parser for CIF parsing.
#**

    "--use-perl-parser" => sub{ $use_parser = 'perl' },
    "--use-c-parser"    => sub{ $use_parser = 'c' },

    "--strict" => sub{ $strict = 1 },
    "--no-strict,--relaxed,--stream,--concatenate" => sub{ $strict = 0 },
);

@ARGV = ( "-" ) unless @ARGV;

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

my $json_options = {
    'canonical' => $canonical
};

print '[' if $strict;
my $first = 1;

for my $filename (@ARGV) {

    my $options = { 'parser' => $use_parser, 'no_print' => 1 };
    my ( $data, $err_count, $messages ) = parse_cif( $filename, $options );

    if ( $err_count > 0 ) {
        print STDERR $_ foreach ( @$messages );
        error( {
            'program'  => $0,
            'filename' => $filename,
            'message'  =>
                "$err_count error(s) encountered while parsing the file"
        } );
        next;
    }
    print STDERR $_ foreach ( @$messages );

    canonicalize_all_names( $data, $options );

    foreach( @$data ) {

        my @atoms = @{ $_->{values}{'_topol_atom.atom_label'} };
        my @destinations = @{ $_->{values}{'_topol_atom.atom_edge_destination_label'} };
        my @labels = @{ $_->{values}{'_topol_atom.edge_label'} };
        my $graph = Graph::Easy->new();
        $graph->strict(undef);
        my @node_colors = ('red', 'green', 'blue', 'orange', 'yellow', 'purple');

        for my $i (0..$#atoms) {
            my $atom = $atoms[$i];
            my $color = $node_colors[$i % @node_colors];
            my $node = $graph->add_node($atom);

            $node->set_attribute('shape', 'circle');
            $node->set_attribute('style', 'filled');
            $node->set_attribute('fillcolor', $color)
        }

        for my $i (0..$#destinations) {
            my $atom = $destinations[$i];
            my $color = $node_colors[$i % @node_colors];
            my @parts = split /_/, $destinations[$i];
            if(@parts > 1 && $parts[1] == 1){
                $atom = $parts[0];
            }
            my $node = $graph->add_node($atom);

            $node->set_attribute('shape', 'circle');
            $node->set_attribute('style', 'filled');
            $node->set_attribute('fillcolor', $color)
        }

        my %original_edges;

        for(my $i = 0; $i <= $#atoms; $i++) {
            my $atom_label = $atoms[$i];
            if($atom_label eq $destinations[$i]) {
                next;
            }
            my $destination;
            my @parts = split /_/, $destinations[$i];
            if(@parts > 1 && $parts[1] == 1){
                $destination = $parts[0];
            } else {
                $destination = $destinations[$i];
            }
            my $label = $labels[$i];
            if($label eq "0,0,0") {
                if(!$original_edges{"$atom_label-$destination-0-0-0"}) {
                    my $edge = $graph->add_edge($atom_label, $destination);
                    
                        $edge->set_attribute('arrowstyle', 'none');
                        $original_edges{"$atom_label-$destination-0-0-0"} = 1;
                        $original_edges{"$destination-$atom_label-0-0-0"} = 1;

                }
            } else {
                $graph->add_edge($atom_label, $destination, $label);
            }
        }
        print $graph->as_graphviz();
    }
}

print ']' if $strict;
