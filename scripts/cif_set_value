#! /bin/sh
#!perl -w # --*- Perl -*--
eval 'exec perl -x $0 ${1+"$@"}'
    if 0;
#------------------------------------------------------------------------------
#$Author$
#$Date$
#$Revision$
#$URL$
#------------------------------------------------------------------------------
#*
#* Set specified CIF data items to the given values.
#*
#* USAGE:
#*    $0 --options input1.cif input*.cif
#**

use strict;
use warnings;
use COD::CIF::Tags::Manage qw( contains_data_item
                               exclude_tag
                               get_item_loop_index
                               set_loop_tag
                               set_tag );
use COD::CIF::Parser qw( parse_cif );
use COD::CIF::Tags::CanonicalNames qw( canonicalize_all_names
                                       canonical_tag_name );
use COD::CIF::Tags::Print qw( print_cif );
use COD::SOptions qw( getOptions );
use COD::SUsage qw( usage options );
use COD::ErrorHandler qw( process_parser_messages );
use COD::ToolsVersion qw( get_version_string );

my $die_on_error_level = {
    ERROR   => 1,
    WARNING => 0,
    NOTE    => 0
};

my $use_parser = 'c';

my $tag = '_atom_site_occupancy';
my $value = 1.0;

my $add_if_nonexistent = 0;
my $backup_tag = '';

#* OPTIONS:
#*   -t, --tag _atom_site_occupancy
#*                     Specify which data item to set.
#*                     Default: "_atom_site_occupancy".
#*   -v, --value 1.0
#*                     Specify a new value for that data item.
#*                     Default: "1.0".
#*
#*   --backup-tag _cod_original_atom_site_occupancy
#*                     Create the specified data item with the original
#*                     values of the modified data item. If set to an
#*                     empty string (""), no backup data item is created.
#*                     Default: "".
#*
#*   --add-tag
#*                     If the given data item does not exist in a data
#*                     block, add it with the specified value.
#*   --no-add-tag
#*                     Only overwrite already existing data items, do not
#*                     add new ones. Default.
#*
#*   --use-perl-parser
#*   --use-c-parser
#*                     Specify parser to parse CIF files.
#*                     Default: C parser.
#*
#*   --help, --usage
#*                     Output a short usage message (this message) and exit.
#*   --version
#*                     Output version information and exit.
#**
@ARGV = getOptions(
    '-t,--tag'   => \$tag,
    '-v,--value' => \$value,

    '--backup-tag' => \$backup_tag,

    '--use-perl-parser' => sub { $use_parser = 'perl' },
    '--use-c-parser'    => sub { $use_parser = 'c' },

    '--add-tag'    => sub { $add_if_nonexistent = 1 },
    '--no-add-tag' => sub { $add_if_nonexistent = 0 },

    '--options'      => sub { options; exit },
    '--help,--usage' => sub { usage; exit },
    '--version'      => sub { print get_version_string(), "\n"; exit }
);

if ($tag ne '' && substr($tag, 0, 1) ne '_') {
    die "$0:: ERROR, data name '$tag' is invalid -- " .
        'CIF data names must start with an underscore' . ".\n";
}

if ($backup_tag ne '' && substr($backup_tag, 0, 1) ne '_') {
    die "$0:: ERROR, data name '$backup_tag' is invalid -- " .
        'CIF data names must start with an underscore' . ".\n";
}

if ($tag eq $backup_tag) {
    warn "$0:: ERROR, the backup data name is identical to the target data " .
         "name -- no backup will be performed" . ".\n";
    $backup_tag = '';
}

$tag        = canonical_tag_name($tag);
$backup_tag = canonical_tag_name($backup_tag);

@ARGV = ('-') unless @ARGV;

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

for my $filename (@ARGV) {

    my $options = { 'parser' => $use_parser, 'no_print' => 1 };
    my ( $data, $err_count, $messages ) = parse_cif( $filename, $options );
    process_parser_messages( $messages, $die_on_error_level );
    next if ( $err_count > 0 );

    canonicalize_all_names( $data );

    for my $dataset (@$data) {
        if( contains_data_item( $dataset, $tag ) ) {
            if ($backup_tag ne '') {
                my $backup_values = [@{$dataset->{values}{$tag}}];
                if (exists $dataset->{values}{$backup_tag}) {
                    warn "$0: $filename: WARNING, backup data item " .
                         "'$backup_tag' is already present in the data file " .
                         "-- old data values will be overwritten" . ".\n";
                    exclude_tag($dataset, $backup_tag);
                }
                if (defined get_item_loop_index($dataset, $tag)) {
                    set_loop_tag( $dataset,
                                  $backup_tag,
                                  $tag,
                                  $backup_values );
                } else {
                    set_tag( $dataset, $backup_tag, $backup_values->[0] );
                }
            }
            for my $cif_value (@{$dataset->{values}{$tag}}) {
                $cif_value = $value;
            }
        } elsif( $add_if_nonexistent ) {
            set_tag( $dataset, $tag, $value );
        }
    }

    for my $dataset( @$data ) {
        print_cif( $dataset, {
            exclude_misspelled_tags => 0,
            preserve_loop_order => 1,
            fold_long_fields => 0,
            keep_tag_order => 1,
        });
    }
}
